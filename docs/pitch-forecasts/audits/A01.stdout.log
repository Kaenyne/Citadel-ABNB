32: def run(nights_mu=9.5, nights_sd=1.6, adr_mu=3.3, adr_sd=1.3,
33:         eps_mu=-0.005, eps_sd=0.020,
34:         fee_w=(0.45, 0.40, 0.15), fee_steps=(0.0, 0.005543, 0.011086),
35:         cushion_mu=0.024, cushion_sd=0.010,
36:         drift_mu=0.0, drift_sd=0.006, street_now=STREET_NOW, seed=20260917, n=N,
37:         gbv_override=None, gbv_override_sd=None):
38:     r = np.random.default_rng(seed)
39:     if gbv_override is None:
40:         g_n = r.normal(nights_mu, nights_sd, n) / 100
41:         g_a = r.normal(adr_mu, adr_sd, n) / 100
