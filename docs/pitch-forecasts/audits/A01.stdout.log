45:     base = (2/3) * gbv3 + (1/3) * GBV_2Q26
46:     eps = r.normal(eps_mu, eps_sd, n)
47:     fee = r.choice(np.array(fee_steps), size=n, p=np.array(fee_w))
48:     print_ = LAMBDA_Q4 * (1 + eps) * base * (1 + fee)
49:     c = r.normal(cushion_mu, cushion_sd, n)
50:     guide = np.round(print_ / (1 + c) / 5) * 5          # letters give $X.XX bn endpoints -> $5m midpoint grid
51:     street = street_now * (1 + r.normal(drift_mu, drift_sd, n))
52:     given = r.random(n) < P_GUIDE_GIVEN
