# Copy only the variables you choose into a local .env file.
# Never commit real credentials. Direct Federal Reserve H.10 downloads need no key.

# Optional FRED API access for metadata/provenance checks; not a substitute for
# dated H.10 release pages in point-in-time backtests.
FRED_API_KEY=

# Optional BLS v2 access for wider date spans and higher documented quotas.
# Phase A uses only no-key v1; keep the real value in an ignored local .env.
BLS_API_KEY=

# Optional NOAA Climate Data Online access for later weather-event controls.
# Not used until the user confirms credential sync and approves Phase B.
NOAA_CDO_TOKEN=

# Optional NASA Earthdata access for the Black Marble moonshot. Do not use
# until the user approves this source and confirms the key is synced locally.
EARTHDATA_TOKEN=
