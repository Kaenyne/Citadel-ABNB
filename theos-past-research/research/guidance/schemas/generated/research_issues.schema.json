{
  "$defs": {
    "IssueStatus": {
      "enum": [
        "open",
        "resolved",
        "accepted_limitation"
      ],
      "title": "IssueStatus",
      "type": "string"
    },
    "Severity": {
      "enum": [
        "high",
        "medium",
        "low"
      ],
      "title": "Severity",
      "type": "string"
    },
    "ValueStatus": {
      "enum": [
        "observed",
        "missing",
        "not_disclosed",
        "not_applicable"
      ],
      "title": "ValueStatus",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "created_at_utc": {
      "format": "date-time",
      "title": "Created At Utc",
      "type": "string"
    },
    "description": {
      "title": "Description",
      "type": "string"
    },
    "guidance_event_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Guidance Event Id"
    },
    "issue_type": {
      "title": "Issue Type",
      "type": "string"
    },
    "missing_reason": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Missing Reason"
    },
    "proposed_resolution": {
      "title": "Proposed Resolution",
      "type": "string"
    },
    "related_record_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Related Record Id"
    },
    "related_record_type": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Related Record Type"
    },
    "requires_user_approval": {
      "title": "Requires User Approval",
      "type": "boolean"
    },
    "research_issue_id": {
      "title": "Research Issue Id",
      "type": "string"
    },
    "resolved_at_utc": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Resolved At Utc"
    },
    "severity": {
      "$ref": "#/$defs/Severity"
    },
    "status": {
      "$ref": "#/$defs/IssueStatus"
    },
    "value_status": {
      "$ref": "#/$defs/ValueStatus",
      "default": "observed"
    }
  },
  "required": [
    "research_issue_id",
    "issue_type",
    "severity",
    "description",
    "proposed_resolution",
    "status",
    "requires_user_approval",
    "created_at_utc"
  ],
  "title": "ResearchIssue",
  "type": "object"
}
