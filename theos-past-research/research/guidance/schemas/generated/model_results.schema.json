    },
    "information_view": {
      "title": "Information View",
      "type": "string"
    },
    "missing_reason": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Missing Reason"
    },
    "model_result_id": {
      "title": "Model Result Id",
      "type": "string"
    },
    "prediction": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
