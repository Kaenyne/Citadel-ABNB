    },
    "random_seed": {
      "title": "Random Seed",
      "type": "integer"
    },
    "specification_code": {
      "title": "Specification Code",
      "type": "string"
    },
    "squared_error": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
