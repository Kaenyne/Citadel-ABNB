    "target_code": {
      "title": "Target Code",
      "type": "string"
    },
    "test_event_id": {
      "title": "Test Event Id",
      "type": "string"
    },
    "train_end_event_id": {
      "title": "Train End Event Id",
      "type": "string"
    },
    "train_start_event_id": {
      "title": "Train Start Event Id",
      "type": "string"
    },
