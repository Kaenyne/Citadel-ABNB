    },
    "baseline_code": {
      "title": "Baseline Code",
      "type": "string"
    },
    "code_version": {
      "title": "Code Version",
      "type": "string"
    },
    "created_at_utc": {
      "format": "date-time",
      "title": "Created At Utc",
      "type": "string"
    },
    "error_improvement": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Error Improvement"
    },
    "feature_codes": {
      "title": "Feature Codes",
      "type": "string"
    },
    "fit_warnings": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
