.venv/
venv/
__pycache__/
*.pyc
.ipynb_checkpoints/
.pytest_cache/

# Secrets / environment
.env
.env.*
*.pem
*.key

# Office temp/lock files
~$*
*.tmp
.~lock.*

# OS / editor
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/

# Large / raw data (link in data/README.md instead)
data/raw/*
!data/raw/.gitkeep
# Small public text inputs kept in git as an exception (see data/README.md)
!data/raw/fred/
!data/raw/bea/
*.parquet
*.zip

# Licensed terminal exports - never commit to a public repo
*bloomberg*
*capiq*
*factset*

# Claude Code local settings
.claude/settings.local.json

# Cross-branch copies used by the predictive study (populate via git show; see data/README.md)
data/external/
# Unpacked third-party forecasting skill, local reference only
docs/forecast-skill/

# Download caches for the overnight scripts (repo-relative replacement for the session
# scratchpad; see docs/overnight/BUILD.md). Regenerated on demand, never committed.
data/cache/

# Regulatory research raw inputs are public (registries, official PDFs, Inside Airbnb and INE extracts) and kept in git
# so the package is reproducible; licensed LSEG story bodies and transcript texts stay local
!data/raw/regulatory/
data/raw/regulatory/lseg/
data/raw/regulatory/phase2/lseg/
data/raw/regulatory/transcripts/
